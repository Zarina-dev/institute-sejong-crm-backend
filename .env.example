# Copy to backend/.env — read from the backend's working directory.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=institut
PORT=3000

# ---- Auth ------------------------------------------------------------------
# Signs API bearer tokens (12 h). Required in production; a dev fallback is used (and logged) when unset.
AUTH_SECRET=
# Administrator login for the admin panel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# ---- Cloudflare R2 (images and videos) -------------------------------------
# Leave all empty to keep images and videos on this server's disk (uploads/).
# Set all of them to store them in an R2 bucket instead:
#   Cloudflare → R2 → Create bucket; Settings → Public access → enable the
#   r2.dev URL or connect a custom domain (that address is R2_PUBLIC_URL);
#   R2 → Manage API tokens → Create token with "Object Read & Write" on the
#   bucket ("Admin Read & Write" also lets `npm run media:to-r2` set CORS).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public address of the bucket, no trailing slash, e.g. https://media.example.kg
R2_PUBLIC_URL=
# Only for S3-compatible test servers; R2 is derived from R2_ACCOUNT_ID.
R2_ENDPOINT=
