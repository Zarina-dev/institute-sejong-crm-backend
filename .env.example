# Copy to backend/.env — read from the backend's working directory.
# One connection string (Railway: ${{Postgres.DATABASE_URL}}) — when set,
# the DB_* lines below are ignored. DB_SSL=true only for a database reached
# over the internet that demands TLS.
DATABASE_URL=
DB_SSL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=institut
PORT=3000

# Proxies in front of the API whose X-Forwarded-For is believed — the client
# IP in 작업 기록 comes from it. A hop count ("1" behind one proxy, "2"
# behind Cloudflare + a host's load balancer) or addresses/subnets. Empty:
# only proxies on this machine or the local network.
TRUST_PROXY=

# ---- Auth ------------------------------------------------------------------
# Signs API bearer tokens (12 h). Set it in production; when unset a random
# secret is made at start (logged), so every restart signs the admin out.
AUTH_SECRET=
# Administrator login for the admin panel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# ---- Cloudflare R2 (all stored files) -------------------------------------
# Required: every upload is stored in R2, none on this server's disk.
# Two buckets, because R2 public access is set per bucket:
#   - R2_BUCKET — public (Settings → Public access → r2.dev URL or custom
#     domain, which is R2_PUBLIC_URL): images/ and videos/;
#   - R2_PRIVATE_BUCKET — no public access: documents/ (회의록) and
#     materials/ (학습자료), read through signed links the API issues.
# R2 → Manage API tokens → a token with Object Read & Write on both buckets
# (Admin Read & Write also lets the migration set CORS).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRIVATE_BUCKET=
# Public address of R2_BUCKET, no trailing slash, e.g. https://media.example.kg
R2_PUBLIC_URL=
# S3 API address; derived from R2_ACCOUNT_ID when empty. Needed for an
# EU-jurisdiction account or an S3-compatible test server. A /<bucket>
# pasted on the end is ignored.
R2_ENDPOINT=
