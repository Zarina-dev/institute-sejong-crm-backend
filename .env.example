# Copy to backend/.env (locally) or set as service variables (Railway).

# PostgreSQL connection string. Railway: ${{Postgres.DATABASE_URL}}.
# Locally, leave it out: the database `npm run db` starts is the default.
DATABASE_URL=

# Redis for the public API cache. Railway: ${{Redis.REDIS_URL}}.
# Optional: without it the cache lives in the API process (fine for one instance).
REDIS_URL=

# Proxies in front of the API whose X-Forwarded-For is believed — the client
# IP in 작업 기록 comes from it. "1" on Railway; "2" with Cloudflare in front.
TRUST_PROXY=

# Signs staff sign-in tokens. A long random value; changing it signs everyone out:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Accounts live in the database (staff_accounts), not here. Make the first
# administrator once per database: npm run build && npm run admin:create -- --username <name>
# (ADMIN_USERNAME / ADMIN_PASSWORD are no longer read.)

# Cloudflare R2 — every stored file. Two buckets:
#   R2_BUCKET — public (photos), served from R2_PUBLIC_URL (no trailing slash);
#   R2_PRIVATE_BUCKET — no public access (회의록 documents, 학습자료).
# R2 → Manage API tokens → Object Read & Write on both buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_URL=
